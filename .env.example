# Copy values from your Supabase project (Settings -> API).
# NEVER commit real keys — this file is a template only.
# Frontend — copy these into frontend/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Backend — copy these into backend/.env (server only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key is backend-only. Never put it in the frontend
# or in any NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=
